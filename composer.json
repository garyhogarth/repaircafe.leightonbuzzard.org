{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "doctrine/dbal": "^3.6",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^10.48",
        "laravel/jetstream": "^2.16",
        "laravel/sanctum": "^3.2",
        "laravel/tinker": "^2.7",
        "livewire/livewire": "^2.11"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.20",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^6.1",
        "phpunit/phpunit": "^9.5.10",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "ignore": {
                "PKSA-m5cs-t1y6-qpcs": "Temporary signed URL path confusion - no fix exists in the 10.x line (fixed in 12.61.1/13.12.0). Accepted as a stepping stone; resolved when upgrading past Laravel 10.",
                "PKSA-3r5d-mb8f-1qw9": "CRLF injection in default email rule (variant) - no fix exists in the 10.x line (fixed in 12.60.0/13.10.0). Accepted as a stepping stone; resolved when upgrading past Laravel 10.",
                "PKSA-mdq4-51ck-6kdq": "CRLF injection in default email rule - no fix exists in the 10.x line (fixed in 11.0.0). Accepted as a stepping stone; resolved when upgrading past Laravel 10."
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
